# Copy to .env and adjust. Every variable is optional.

# ── Server ──────────────────────────────────────────────────────────────────
# PORT=3000
# LOG_LEVEL=info
# DATA_DIR=./data                 # SQLite database + per-run workspaces
# EVALS_DIR=./evals               # suites, configs, skills, fixtures

# ── Execution ───────────────────────────────────────────────────────────────
# HERMES_BIN=hermes               # Hermes CLI (the Docker image sets this for you)
# MAX_CONCURRENCY=4               # runs in flight across all experiments
# RUN_MAX_ATTEMPTS=3              # attempts per run for infrastructure errors
# RUN_RETRY_DELAY_MS=5000         # base of the exponential retry backoff
# KEEP_RUN_HOME=false             # keep each run's HERMES_HOME for debugging

# ── Model endpoints referenced by evals/configs ─────────────────────────────
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OPENROUTER_API_KEY=sk-or-...    # only for configs that set apiKeyEnv: OPENROUTER_API_KEY

# ── LLM judge (used by llm_judge scorers; any OpenAI-compatible endpoint) ───
# JUDGE_BASE_URL=http://localhost:11434/v1
# JUDGE_MODEL=gemma4:31b-cloud
# JUDGE_API_KEY=
# JUDGE_TIMEOUT_SEC=120
