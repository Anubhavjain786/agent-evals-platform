{
  "name": "@agent-evals/api",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS backend: definitions registry, run scheduler, Hermes runner, scoring and analysis.",
  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@agent-evals/shared": "1.0.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/serve-static": "^5.0.3",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.45.4",
    "helmet": "^8.3.0",
    "nestjs-pino": "^4.4.1",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.8",
    "@nestjs/testing": "^11.1.6",
    "@swc/core": "^1.13.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.5",
    "pino-pretty": "^13.1.1",
    "supertest": "^7.1.4",
    "unplugin-swc": "^1.5.7",
    "vitest": "^4.1.11"
  }
}
